\@writefile{lof}{\contentsline {figure}{\numberline {57}{\ignorespaces Observed 2015 full-sample scan on 19--100\nobreakspace  {}MeV with 14--135\nobreakspace  {}MeV GP support. From top to bottom: the 90\% CL$_\mathrm  {s}${} full-template signal-yield upper limit $A_{90}$, the corresponding $\epsilon ^2$ upper limit, discovery probabilities, and aligned $Z^+$ values. The local asymptotic reference is black and the Sidak reference is red, with $N_{\rm  eff}=14.521$. At 51\nobreakspace  {}MeV they give $Z=3.139$ and $Z_{\rm  Sidak}=2.250$. The added 91--100\nobreakspace  {}MeV fits use the fixed endpoint prescription; the shaded interval has the conditional status in Appendix\nobreakspace  {}\ref  {app:v504-extension}. The Sidak reference is distinct from the conditional GP global calculation in Section\nobreakspace  {}\ref  {sec:v5-global-results}.\relax }}{89}{figure.caption.75}\protected@file@percent }
\newlabel{fig:v501-scan-2015}{{57}{89}{Observed 2015 full-sample scan on 19--100~MeV with 14--135~MeV GP support. From top to bottom: the 90\% \CLs {} full-template signal-yield upper limit $A_{90}$, the corresponding $\epsilon ^2$ upper limit, discovery probabilities, and aligned $Z^+$ values. The local asymptotic reference is black and the Sidak reference is red, with $N_{\rm eff}=14.521$. At 51~MeV they give $Z=3.139$ and $Z_{\rm Sidak}=2.250$. The added 91--100~MeV fits use the fixed endpoint prescription; the shaded interval has the conditional status in Appendix~\ref {app:v504-extension}. The Sidak reference is distinct from the conditional GP global calculation in Section~\ref {sec:v5-global-results}.\relax }{figure.caption.75}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {58}{\ignorespaces Corresponding observed 2016 full-sample scan on 39--180\nobreakspace  {}MeV with 30--210\nobreakspace  {}MeV GP support. The panels show the full-template $A_{90}$, $\epsilon ^2$ limit, discovery probabilities, and aligned $Z^+$ values. Black is local and red is the Sidak reference with $N_{\rm  eff}=16.062$; their values at 90\nobreakspace  {}MeV are 3.424 and 2.579. \relax }}{90}{figure.caption.76}\protected@file@percent }
\newlabel{fig:v501-scan-2016}{{58}{90}{Corresponding observed 2016 full-sample scan on 39--180~MeV with 30--210~MeV GP support. The panels show the full-template $A_{90}$, $\epsilon ^2$ limit, discovery probabilities, and aligned $Z^+$ values. Black is local and red is the Sidak reference with $N_{\rm eff}=16.062$; their values at 90~MeV are 3.424 and 2.579. \relax }{figure.caption.76}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {59}{\ignorespaces Corresponding observed 2021 10\% scan on 50--250\nobreakspace  {}MeV with 36--300\nobreakspace  {}MeV GP support. The panels show the full-template $A_{90}$, minimal-visible $\epsilon ^2$ limit, discovery probabilities, and aligned $Z^+$ values. Black is local and red is the Sidak reference with $N_{\rm  eff}=26.402$; their values at 78\nobreakspace  {}MeV are 2.810 and 1.527. Above the dimuon threshold the inherited branching correction enters the coupling conversion once; it does not change the visible electron-pair yield or local probability.\relax }}{91}{figure.caption.77}\protected@file@percent }
\newlabel{fig:v501-scan-2021}{{59}{91}{Corresponding observed 2021 10\% scan on 50--250~MeV with 36--300~MeV GP support. The panels show the full-template $A_{90}$, minimal-visible $\epsilon ^2$ limit, discovery probabilities, and aligned $Z^+$ values. Black is local and red is the Sidak reference with $N_{\rm eff}=26.402$; their values at 78~MeV are 2.810 and 1.527. Above the dimuon threshold the inherited branching correction enters the coupling conversion once; it does not change the visible electron-pair yield or local probability.\relax }{figure.caption.77}{}}
