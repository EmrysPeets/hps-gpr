\@writefile{lof}{\contentsline {figure}{\numberline {43}{\ignorespaces Historical 2015 matched-reference training-exclusion comparison, restored from the v4.9.7 validation archive. The extraction width was $1.64\sigma _m$, while the training exclusion was varied through $1.96$, $2.25$, $2.58$ and $3.00\sigma _m$. Recovered coupling coordinates are divided by the injected values. The $2.25\sigma _m$ choice substantially reduces under-recovery relative to the narrow guard, while avoiding the larger uncertainty cost of wider exclusions. The plotted spreads belong to the archived ensembles, not a new confidence-limit calibration.\relax }}{65}{figure.caption.52}\protected@file@percent }
\newlabel{fig:v501-blind-optimization-history}{{43}{65}{Historical 2015 matched-reference training-exclusion comparison, restored from the v4.9.7 validation archive. The extraction width was $1.64\sigma _m$, while the training exclusion was varied through $1.96$, $2.25$, $2.58$ and $3.00\sigma _m$. Recovered coupling coordinates are divided by the injected values. The $2.25\sigma _m$ choice substantially reduces under-recovery relative to the narrow guard, while avoiding the larger uncertainty cost of wider exclusions. The plotted spreads belong to the archived ensembles, not a new confidence-limit calibration.\relax }{figure.caption.52}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {44}{\ignorespaces Residual fitted significance in the same historical 2015 training-exclusion study as Fig.\nobreakspace  {}\ref  {fig:v501-blind-optimization-history}. The common mass and injection grid compares the response after the signal strength has been set by its matched reference. Together with amplitude recovery, this diagnoses the signal-absorption cost of letting the GP train too close to the extraction window.\relax }}{66}{figure.caption.53}\protected@file@percent }
\newlabel{fig:v501-blind-significance-history}{{44}{66}{Residual fitted significance in the same historical 2015 training-exclusion study as Fig.~\ref {fig:v501-blind-optimization-history}. The common mass and injection grid compares the response after the signal strength has been set by its matched reference. Together with amplitude recovery, this diagnoses the signal-absorption cost of letting the GP train too close to the extraction window.\relax }{figure.caption.53}{}}
