\@writefile{lof}{\contentsline {figure}{\numberline {56}{\ignorespaces Positive injected signals can induce nearby fitted oscillations through the moving-mask background regression. The injection-induced change is $\Delta r(m)=r_m(B+S)-r_m(B)$ for the same smooth reference spectrum. The 65+78\nobreakspace  {}MeV pair can induce a deep fitted deficit even though both generating signal components are nonnegative. These are conditional response illustrations; their agreement with one selected dip does not establish the identity of the observed parent peak.\relax }}{88}{figure.caption.69}\protected@file@percent }
\newlabel{fig:v5-signal-echo}{{56}{88}{Positive injected signals can induce nearby fitted oscillations through the moving-mask background regression. The injection-induced change is $\Delta r(m)=r_m(B+S)-r_m(B)$ for the same smooth reference spectrum. The 65+78~MeV pair can induce a deep fitted deficit even though both generating signal components are nonnegative. These are conditional response illustrations; their agreement with one selected dip does not establish the identity of the observed parent peak.\relax }{figure.caption.69}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {57}{\ignorespaces 2015 correlation of nominal local fit fluctuations across mass under the archived coherent background. Correlation describes how fluctuations co-vary; it does not assign a significance to a particular observed oscillation. The matrix shows the significance-GP prediction; independent complete Poisson comparisons are retained in the archived validation study.\relax }}{89}{figure.caption.70}\protected@file@percent }
\newlabel{fig:v5-correlations-2015}{{57}{89}{2015 correlation of nominal local fit fluctuations across mass under the archived coherent background. Correlation describes how fluctuations co-vary; it does not assign a significance to a particular observed oscillation. The matrix shows the significance-GP prediction; independent complete Poisson comparisons are retained in the archived validation study.\relax }{figure.caption.70}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {58}{\ignorespaces The corresponding 2016 mass-correlation study. Its agreement with direct scans checks the response approximation conditional on the generating spectrum; it does not qualify that spectrum as a physical background.\relax }}{90}{figure.caption.71}\protected@file@percent }
\newlabel{fig:v5-correlations-2016}{{58}{90}{The corresponding 2016 mass-correlation study. Its agreement with direct scans checks the response approximation conditional on the generating spectrum; it does not qualify that spectrum as a physical background.\relax }{figure.caption.71}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {59}{\ignorespaces The corresponding correlation study for the released 2021 10\% configuration. Alternating positive and negative correlations help explain why neighboring extrema need not be independent. Signal injection is a separate test of the response to a changed generating mean.\relax }}{91}{figure.caption.72}\protected@file@percent }
\newlabel{fig:v5-correlations-2021}{{59}{91}{The corresponding correlation study for the released 2021 10\% configuration. Alternating positive and negative correlations help explain why neighboring extrema need not be independent. Signal injection is a separate test of the response to a changed generating mean.\relax }{figure.caption.72}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {60}{\ignorespaces Correlation matrix of the combined local-significance field across the full 19--250\nobreakspace  {}MeV search. The shared response basis preserves correlations across boundaries where campaign membership changes. Regions with no common data have zero response covariance in this conditional model. This is the combined-correlation figure from the v4.9.16 extraction report, with the statistic labelled by its nominal local-significance interpretation.\relax }}{92}{figure.caption.73}\protected@file@percent }
\newlabel{fig:v5-correlations-combined}{{60}{92}{Correlation matrix of the combined local-significance field across the full 19--250~MeV search. The shared response basis preserves correlations across boundaries where campaign membership changes. Regions with no common data have zero response covariance in this conditional model. This is the combined-correlation figure from the v4.9.16 extraction report, with the statistic labelled by its nominal local-significance interpretation.\relax }{figure.caption.73}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {61}{\ignorespaces Conditional changes in the local-significance coordinate following a one-standard-deviation field fluctuation at 51\nobreakspace  {}MeV in 2015, 90\nobreakspace  {}MeV in 2016 and 78\nobreakspace  {}MeV in 2021. The curves are $s_mK_{m,m_0}$, with each archived offset removed. Positive and negative lobes show the scale and sign of correlated fluctuations. These are Gaussian conditional means, not injected particles, probabilities of observed echoes, or independent significance gains.\relax }}{93}{figure.caption.74}\protected@file@percent }
\newlabel{fig:v5-conditional-echo}{{61}{93}{Conditional changes in the local-significance coordinate following a one-standard-deviation field fluctuation at 51~MeV in 2015, 90~MeV in 2016 and 78~MeV in 2021. The curves are $s_mK_{m,m_0}$, with each archived offset removed. Positive and negative lobes show the scale and sign of correlated fluctuations. These are Gaussian conditional means, not injected particles, probabilities of observed echoes, or independent significance gains.\relax }{figure.caption.74}{}}
