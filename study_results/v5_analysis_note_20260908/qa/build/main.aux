\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 2016 smeared-$A^\prime $ and M{\o }ller-based mass-resolution summary \cite  {HPS2016BumpInternal}. The smeared $A^\prime $ points show how the data-driven momentum-smearing correction is propagated away from the single M{\o }ller calibration point. The worsening resolution with mass broadens the signal window and is one of the main detector effects limiting prompt sensitivity at higher mass.\relax }}{19}{figure.caption.12}\protected@file@percent }
\newlabel{fig:2016-resolution}{{10}{19}{2016 smeared-$A^\prime $ and M{\o }ller-based mass-resolution summary \cite {HPS2016BumpInternal}. The smeared $A^\prime $ points show how the data-driven momentum-smearing correction is propagated away from the single M{\o }ller calibration point. The worsening resolution with mass broadens the signal window and is one of the main detector effects limiting prompt sensitivity at higher mass.\relax }{figure.caption.12}{}}
