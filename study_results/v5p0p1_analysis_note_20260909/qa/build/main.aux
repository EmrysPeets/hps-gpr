\@writefile{lof}{\contentsline {figure}{\numberline {41}{\ignorespaces Historical 2015 matched-reference training-exclusion comparison, restored from the v4.9.7 validation archive. The extraction width was $1.64\sigma _m$, while the training exclusion was varied through $1.96$, $2.25$, $2.58$ and $3.00\sigma _m$. Recovered coupling coordinates are divided by the injected values. The $2.25\sigma _m$ choice substantially reduces under-recovery relative to the narrow guard, while avoiding the larger uncertainty cost of wider exclusions. The plotted spreads belong to the archived ensembles, not a new confidence-limit calibration.\relax }}{61}{figure.caption.50}\protected@file@percent }
\newlabel{fig:v501-blind-optimization-history}{{41}{61}{Historical 2015 matched-reference training-exclusion comparison, restored from the v4.9.7 validation archive. The extraction width was $1.64\sigma _m$, while the training exclusion was varied through $1.96$, $2.25$, $2.58$ and $3.00\sigma _m$. Recovered coupling coordinates are divided by the injected values. The $2.25\sigma _m$ choice substantially reduces under-recovery relative to the narrow guard, while avoiding the larger uncertainty cost of wider exclusions. The plotted spreads belong to the archived ensembles, not a new confidence-limit calibration.\relax }{figure.caption.50}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {42}{\ignorespaces Residual fitted significance in the same historical 2015 training-exclusion study as Fig.\nobreakspace  {}\ref  {fig:v501-blind-optimization-history}. The common mass and injection grid compares the response after the signal strength has been set by its matched reference. Together with amplitude recovery, this diagnoses the signal-absorption cost of letting the GP train too close to the extraction window.\relax }}{62}{figure.caption.51}\protected@file@percent }
\newlabel{fig:v501-blind-significance-history}{{42}{62}{Residual fitted significance in the same historical 2015 training-exclusion study as Fig.~\ref {fig:v501-blind-optimization-history}. The common mass and injection grid compares the response after the signal strength has been set by its matched reference. Together with amplitude recovery, this diagnoses the signal-absorption cost of letting the GP train too close to the extraction window.\relax }{figure.caption.51}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {43}{\ignorespaces Signal-extraction pull means from the same historical training-exclusion comparison. The mass-dependent offsets supplement the recovery diagnostics in Figs.\nobreakspace  {}\ref  {fig:v501-blind-optimization-history} and \ref  {fig:v501-blind-significance-history}. These are historical conditional response tests for the stated generating truth and masks.\relax }}{63}{figure.caption.52}\protected@file@percent }
\newlabel{fig:v501-blind-pull-history}{{43}{63}{Signal-extraction pull means from the same historical training-exclusion comparison. The mass-dependent offsets supplement the recovery diagnostics in Figs.~\ref {fig:v501-blind-optimization-history} and \ref {fig:v501-blind-significance-history}. These are historical conditional response tests for the stated generating truth and masks.\relax }{figure.caption.52}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {44}{\ignorespaces Signal-extraction pull widths from the same historical training-exclusion comparison. They test the reported uncertainty scale alongside the pull means in Fig.\nobreakspace  {}\ref  {fig:v501-blind-pull-history}. The recovery, mean and width diagnostics informed the $2.25\sigma _m$ training choice; the subsequent extraction-geometry comparison is shown separately below.\relax }}{64}{figure.caption.53}\protected@file@percent }
\newlabel{fig:v501-blind-width-history}{{44}{64}{Signal-extraction pull widths from the same historical training-exclusion comparison. They test the reported uncertainty scale alongside the pull means in Fig.~\ref {fig:v501-blind-pull-history}. The recovery, mean and width diagnostics informed the $2.25\sigma _m$ training choice; the subsequent extraction-geometry comparison is shown separately below.\relax }{figure.caption.53}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {45}{\ignorespaces The subsequent matched-reference comparison of two extraction geometries in the same 2015 functional-form study. Both exclude training bins out to $2.25\sigma _m$; one retains a $1.64\sigma _m$ extraction and a separate guard, while the other fits all bins inside $2.25\sigma _m$. The $z=0,1,3,5$ pull means and widths show similar conditional behavior. Together with the retained signal tails, this supported the widened blind/extraction window. Historical numerical values are unchanged.\relax }}{65}{figure.caption.54}\protected@file@percent }
\newlabel{fig:v501-blind-geometry-history}{{45}{65}{The subsequent matched-reference comparison of two extraction geometries in the same 2015 functional-form study. Both exclude training bins out to $2.25\sigma _m$; one retains a $1.64\sigma _m$ extraction and a separate guard, while the other fits all bins inside $2.25\sigma _m$. The $z=0,1,3,5$ pull means and widths show similar conditional behavior. Together with the retained signal tails, this supported the widened blind/extraction window. Historical numerical values are unchanged.\relax }{figure.caption.54}{}}
