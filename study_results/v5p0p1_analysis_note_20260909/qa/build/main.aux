\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Traditional baseline fits to the \emph  {original} observed data at the fixed GP-selected masses. The two methods use different background models and windows. Here $p_0=\overline  \Phi [\qopname  \relax m{max}(0,r)]$ with 0.5 for nonpositive roots. These are uncalibrated local references at masses selected with the same events. In particular, the small 2015/21 MeV value accompanies a poor background description and must not be quoted as a particle significance.\relax }}{135}{table.caption.116}\protected@file@percent }
\newlabel{tab:traditional-base}{{17}{135}{Traditional baseline fits to the \emph {original} observed data at the fixed GP-selected masses. The two methods use different background models and windows. Here $p_0=\overline \Phi [\max (0,r)]$ with 0.5 for nonpositive roots. These are uncalibrated local references at masses selected with the same events. In particular, the small 2015/21 MeV value accompanies a poor background description and must not be quoted as a particle significance.\relax }{table.caption.116}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {94}{\ignorespaces Traditional baseline fits to full 2015 data. At 51 and 21\nobreakspace  {}MeV the nominal local coordinates are 0.131 and 5.580, with $D/\mathrm  {dof}=141.69/131$ and $92.50/50$. Adjacent bins are summed for display: 0.75 MeV at the 51 MeV hypothesis, and 0.25 MeV at 21 MeV. Every fit still uses the original 0.25 MeV bins. Counts and residuals are divided by the actual displayed width, including a partial endpoint group. Bottom: data minus the refitted null background, with counting errors only. The red Gaussian is not the blue total change: the polynomial background also moves. Subtraction induces correlated residuals. The large 21 MeV root accompanies an inadequate overall fit. Table\nobreakspace  {}\ref  {tab:traditional-all} retains all variants, including the badly fitting degree-two model at 51 MeV; neither extreme is a defensible physical significance.\relax }}{136}{figure.caption.117}\protected@file@percent }
\newlabel{fig:traditional-2015}{{94}{136}{Traditional baseline fits to full 2015 data. At 51 and 21~MeV the nominal local coordinates are 0.131 and 5.580, with $D/\mathrm {dof}=141.69/131$ and $92.50/50$. Adjacent bins are summed for display: 0.75 MeV at the 51 MeV hypothesis, and 0.25 MeV at 21 MeV. Every fit still uses the original 0.25 MeV bins. Counts and residuals are divided by the actual displayed width, including a partial endpoint group. Bottom: data minus the refitted null background, with counting errors only. The red Gaussian is not the blue total change: the polynomial background also moves. Subtraction induces correlated residuals. The large 21 MeV root accompanies an inadequate overall fit. Table~\ref {tab:traditional-all} retains all variants, including the badly fitting degree-two model at 51 MeV; neither extreme is a defensible physical significance.\relax }{figure.caption.117}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {95}{\ignorespaces Traditional baseline fits to full 2016 data. At 90 and 117\nobreakspace  {}MeV the nominal local coordinates are 1.998 and 1.525, with $D/\mathrm  {dof}=125.35/113$ and $165.59/155$. The display sums five adjacent native bins to 1.25 MeV; any partial endpoint is retained. Counts, residuals and predictions are divided by each displayed width. Fits and probabilities still use the original 0.25 MeV bins. Both baseline positive roots are weaker than their GP values. Reducing the polynomial degree gives negative yields and larger deviances (Table\nobreakspace  {}\ref  {tab:traditional-all}). All alternatives are retained. Numerical convergence does not establish that a background describes the data; nominal local probabilities refer only to that model at the already selected mass.\relax }}{137}{figure.caption.118}\protected@file@percent }
\newlabel{fig:traditional-2016}{{95}{137}{Traditional baseline fits to full 2016 data. At 90 and 117~MeV the nominal local coordinates are 1.998 and 1.525, with $D/\mathrm {dof}=125.35/113$ and $165.59/155$. The display sums five adjacent native bins to 1.25 MeV; any partial endpoint is retained. Counts, residuals and predictions are divided by each displayed width. Fits and probabilities still use the original 0.25 MeV bins. Both baseline positive roots are weaker than their GP values. Reducing the polynomial degree gives negative yields and larger deviances (Table~\ref {tab:traditional-all}). All alternatives are retained. Numerical convergence does not establish that a background describes the data; nominal local probabilities refer only to that model at the already selected mass.\relax }{figure.caption.118}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {96}{\ignorespaces Traditional baseline fits to the released 2021 10\% sample. At 78 and 65\nobreakspace  {}MeV the signed local coordinates are $-1.350$ and 1.960, with $D/\mathrm  {dof}=29.16/24$ and $17.36/22$. Original 0.625 MeV bins are retained and displayed as counts per MeV. The 78 MeV feature becomes a deficit for every specified conventional fit. The 65 MeV baseline remains a modest positive excess. Its degree-two alternative gives a very large positive root but $D/\mathrm  {dof}=28.10$, showing a severe background-model failure (Table\nobreakspace  {}\ref  {tab:traditional-all}). Counting bars and the fitted Gaussian component are visual aids, not independent residual significances. No additional 2021 data were opened.\relax }}{138}{figure.caption.119}\protected@file@percent }
\newlabel{fig:traditional-2021}{{96}{138}{Traditional baseline fits to the released 2021 10\% sample. At 78 and 65~MeV the signed local coordinates are $-1.350$ and 1.960, with $D/\mathrm {dof}=29.16/24$ and $17.36/22$. Original 0.625 MeV bins are retained and displayed as counts per MeV. The 78 MeV feature becomes a deficit for every specified conventional fit. The 65 MeV baseline remains a modest positive excess. Its degree-two alternative gives a very large positive root but $D/\mathrm {dof}=28.10$, showing a severe background-model failure (Table~\ref {tab:traditional-all}). Counting bars and the fitted Gaussian component are visual aids, not independent residual significances. No additional 2021 data were opened.\relax }{figure.caption.119}{}}
