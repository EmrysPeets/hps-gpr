\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces 2021 M{\o }ller run data/MC mass-resolution comparison used to set the smearing scale. Here UC denotes the unconstrained vertex sample, BSC denotes the beamspot-constrained vertex sample, and TC denotes the target-constrained vertex sample. The TC row is the most relevant row for the prompt analysis; comparing the data value \SI {2.186}{MeV} to the $\Omega $+hit-smeared Monte Carlo value \SI {1.745}{MeV} gives the applied scale factor $2.186/1.745\simeq 1.25$.\relax }}{25}{figure.caption.19}\protected@file@percent }
\newlabel{fig:2021-data-mc-smearing-scale}{{17}{25}{2021 M{\o }ller run data/MC mass-resolution comparison used to set the smearing scale. Here UC denotes the unconstrained vertex sample, BSC denotes the beamspot-constrained vertex sample, and TC denotes the target-constrained vertex sample. The TC row is the most relevant row for the prompt analysis; comparing the data value \SI {2.186}{MeV} to the $\Omega $+hit-smeared Monte Carlo value \SI {1.745}{MeV} gives the applied scale factor $2.186/1.745\simeq 1.25$.\relax }{figure.caption.19}{}}
