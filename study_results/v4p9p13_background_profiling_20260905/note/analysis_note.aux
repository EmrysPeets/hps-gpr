\@writefile{toc}{\contentsline {section}{\numberline {3}Controlled 2021 comparison}{3}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Observed 2021 10\% limits under the released Gaussian profile, the direct log-GP profile, and the fixed GP mean. The lower panels divide by the released limit. Every curve uses the same native data and frozen analysis settings; the standard dimuon branching correction is applied once above threshold. The fixed curve omits estimation uncertainty.\relax }}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:2021}{{1}{3}{Observed 2021 10\% limits under the released Gaussian profile, the direct log-GP profile, and the fixed GP mean. The lower panels divide by the released limit. Every curve uses the same native data and frozen analysis settings; the standard dimuon branching correction is applied once above threshold. The fixed curve omits estimation uncertainty.\relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Separating model dependence from numerical differences. Left: direct log-GP and a stable re-solution of the Gaussian model, each relative to the release. Right: the two models evaluated with the same stable solver. The maximum Gaussian-control/release difference is 1.139\%; the maximum same-solver distribution effect is 0.232\%.\relax }}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:numerical}{{2}{3}{Separating model dependence from numerical differences. Left: direct log-GP and a stable re-solution of the Gaussian model, each relative to the release. Right: the two models evaluated with the same stable solver. The maximum Gaussian-control/release difference is \GaussianReleaseMax \%; the maximum same-solver distribution effect is \LogControlMax \%.\relax }{figure.caption.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Signal-plus-background displays}{4}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Fits at 65 and 71 MeV, including the signed deficit fit. Curves for a profiled background or total model stop at the actual fit mask; all residuals subtract the same sideband GP mean. This removes artificial joins between profiled and unprofiled baselines. The shaded GP band is a marginal background uncertainty, not an independent residual error or goodness-of-fit test.\relax }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:fits-low}{{3}{4}{Fits at 65 and 71 MeV, including the signed deficit fit. Curves for a profiled background or total model stop at the actual fit mask; all residuals subtract the same sideband GP mean. This removes artificial joins between profiled and unprofiled baselines. The shaded GP band is a marginal background uncertainty, not an independent residual error or goodness-of-fit test.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Selected fitted yields}{5}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  The same display at 78 and 182 MeV. The released fitted components are retained and the direct log-GP total is overlaid. The peak--dip behavior survives the change of background distribution. The v4.9.12.5 positive-injection studies demonstrate that neighboring signal entering the moving training region can induce negative responses; they do not identify the cause of the observed dip.\relax }}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:fits-high}{{4}{5}{The same display at 78 and 182 MeV. The released fitted components are retained and the direct log-GP total is overlaid. The peak--dip behavior survives the change of background distribution. The v4.9.12.5 positive-injection studies demonstrate that neighboring signal entering the moving training region can induce negative responses; they do not identify the cause of the observed dip.\relax }{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Signed signal yields in the actual fit window (events) and signed likelihood roots. Negative values are extraction diagnostics; discovery uses $Z=\qopname  \relax m{max}(r,0)$. The three columns of $r$ are conditional on their respective background treatments.\relax }}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:fits}{{2}{5}{Signed signal yields in the actual fit window (events) and signed likelihood roots. Negative values are extraction diagnostics; discovery uses $Z=\max (r,0)$. The three columns of $r$ are conditional on their respective background treatments.\relax }{table.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Fixed-background observed extension}{6}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Observed 90\% \ensuremath  {CL_s}{} limits for full 2015, full 2016, 2021 10\%, and the all-three shared-coupling fit. Ratio panels show fixed/released. Each panel has its own mass range and vertical scale. Fixing the mean changes both the uncertainty and fitted yield, so some observed limits become weaker.\relax }}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:all-limits}{{5}{6}{Observed 90\% \CLs {} limits for full 2015, full 2016, 2021 10\%, and the all-three shared-coupling fit. Ratio panels show fixed/released. Each panel has its own mass range and vertical scale. Fixing the mean changes both the uncertainty and fitted yield, so some observed limits become weaker.\relax }{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Fixed/released observed-limit ratios. Ratios describe the displayed conditional limits; a smaller value alone does not establish increased sensitivity.\relax }}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:observed}{{3}{6}{Fixed/released observed-limit ratios. Ratios describe the displayed conditional limits; a smaller value alone does not establish increased sensitivity.\relax }{table.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Local asymptotic background-only p-values}{7}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  Local $p_0$ using Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:pzero}\unskip \@@italiccorr )}}. The fixed curves show the consequence of treating an estimated background as exactly known; their tiny values are not calibrated discovery evidence. Mass hypotheses are correlated. The 2016 state and the all-three curve retain the parent's numerical exception.\relax }}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:all-pzero}{{6}{7}{Local $p_0$ using Eq.~\eqref {eq:pzero}. The fixed curves show the consequence of treating an estimated background as exactly known; their tiny values are not calibrated discovery evidence. Mass hypotheses are correlated. The 2016 state and the all-three curve retain the parent's numerical exception.\relax }{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Minimum local asymptotic $p_0$ in each scope. Fixed columns assume an exactly known GP mean; their quoted $Z$ values are model-conditional transformations, not calibrated significances. No global correction or local rescaling is applied.\relax }}{7}{table.caption.10}\protected@file@percent }
\newlabel{tab:pzero}{{4}{7}{Minimum local asymptotic $p_0$ in each scope. Fixed columns assume an exactly known GP mean; their quoted $Z$ values are model-conditional transformations, not calibrated significances. No global correction or local rescaling is applied.\relax }{table.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Separating an observed fluctuation from conditional precision}{8}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  Deterministic background-only Asimov limits at the frozen GP mean, using the same stable solver for fixed and Gaussian-profiled backgrounds. These curves remove the observed signal fluctuation from the comparison, but retain the assumed background and constraint model. They are not expected-toy bands or a calibration of sensitivity.\relax }}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:asimov}{{7}{8}{Deterministic background-only Asimov limits at the frozen GP mean, using the same stable solver for fixed and Gaussian-profiled backgrounds. These curves remove the observed signal fluctuation from the comparison, but retain the assumed background and constraint model. They are not expected-toy bands or a calibration of sensitivity.\relax }{figure.caption.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Signal injection and extraction}{9}{section.6}\protected@file@percent }
\newlabel{sec:toys}{{6}{9}{Signal injection and extraction}{section.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  Background-only extraction. Pull is $(\hat  A-A_{\rm  true})/\hat  \sigma _A$. Masses are equally spaced categories here and in the next toy figures. Bars show approximate Monte Carlo standard errors. Fixed pull widths are 0.94--1.01{} in the known-background control and 1.85--2.65{} with GP uncertainty. Profiled widths in the latter are 0.97--1.05{}.\relax }}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:closure}{{8}{9}{Background-only extraction. Pull is $(\hat A-A_{\rm true})/\hat \sigma _A$. Masses are equally spaced categories here and in the next toy figures. Bars show approximate Monte Carlo standard errors. Fixed pull widths are \KnownWidthRange {} in the known-background control and \UncertainWidthRange {} with GP uncertainty. Profiled widths in the latter are \ProfileWidthRange {}.\relax }{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Bias and exclusion of the injected yield}{10}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces  Mean pull for the two positive injections, using the same physical yield for both methods. The retrained 71 MeV truth produces bias in both fits. Bars are standard errors of the mean pull, not signal-yield uncertainties.\relax }}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:bias}{{9}{10}{Mean pull for the two positive injections, using the same physical yield for both methods. The retrained 71 MeV truth produces bias in both fits. Bars are standard errors of the mean pull, not signal-yield uncertainties.\relax }{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Exclusion frequencies and current-method limitations}{11}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces  Fraction of toys with $\ensuremath  {CL_s}(A_{\rm  true})<0.1$, with exact 95\% binomial intervals. The 10\% reference is the nominal upper-bound benchmark; \ensuremath  {CL_s}{} can be conservative. At zero injection the physical bound would make this test uninformative, so only positive strengths are shown. These are conditional exclusion frequencies, not unconditional coverage estimates.\relax }}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:exclusion}{{10}{11}{Fraction of toys with $\CLs (A_{\rm true})<0.1$, with exact 95\% binomial intervals. The 10\% reference is the nominal upper-bound benchmark; \CLs {} can be conservative. At zero injection the physical bound would make this test uninformative, so only positive strengths are shown. These are conditional exclusion frequencies, not unconditional coverage estimates.\relax }{figure.caption.14}{}}
